source=(
  "${pkgname}::git+https://github.com/thumbsup/thumbsup.git"
  "fix_node_allow_scripts.diff"
  "413.diff"
)

pkgver() {
    cd $pkgname
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd $srcdir/$pkgname
  patch < ../fix_node_allow_scripts.diff
  patch -p1 < ../413.diff

}
