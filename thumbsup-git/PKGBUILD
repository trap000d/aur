  npm install --cache "$srcdir/npm-cache"
  #npm approve-scripts better-sqlite3
  #npm install --cache "$srcdir/npm-cache"
  npm install -g --prefix "$pkgdir/usr"

  unlink "$pkgdir/usr/lib/node_modules/thumbsup"
  mkdir -p "${pkgdir}/usr/lib/node_modules/thumbsup"
  cp -a node_modules "${pkgdir}/usr/lib/node_modules/thumbsup/node_modules"
  cp -a src "${pkgdir}/usr/lib/node_modules/thumbsup/src"
  cp -a bin "${pkgdir}/usr/lib/node_modules/thumbsup/bin"
